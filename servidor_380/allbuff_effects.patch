+// broadcastGMBuffEffect plays the skill's cast animation (S_SkillSoundGFX) on the target for everyone
+// nearby; the normal cast path does this, the GM path used to skip it.
+func (s *SkillSystem) broadcastGMBuffEffect(player *world.PlayerInfo, skill *data.SkillInfo) {
+	if skill.CastGfx <= 0 {
+		return
+	}
+	nearby := s.deps.World.GetNearbyPlayersInShow(player.X, player.Y, player.MapID, 0, player.ShowID)
+	handler.BroadcastToPlayers(nearby, handler.BuildSkillEffect(player.CharID, skill.CastGfx))
+}
