+// reindex moves an alliance whose order id changed (first save) to its new key.
+func (m *AllianceManager) reindex(a *AllianceInfo) {
+	for k, v := range m.alliances {
+		if v == a {
+			delete(m.alliances, k)
+		}
+	}
+	m.alliances[a.OrderID] = a
 }
