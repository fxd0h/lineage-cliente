+// Alliance Y/N dialog ids (the client string table message numbers): 223 = "Lord of %0 Blood Pledge wants to
+// form an alliance. Do you accept?", 1210 = "Are you sure you want to withdraw from the alliance?".
+const (
+	allianceInviteYesNo = 223
+	allianceLeaveYesNo  = 1210
+	allianceMinLevel    = 25 // only lords of clans of level 25+ can apply (msg 1206)
+)
+
+// alliancePrince is the clan that formed the alliance (slot 0): only it can invite more clans.
+func (a *AllianceInfo) alliancePrince() int32 { return a.ClanIDs[0] }
+
+// notifyAlliance runs fn for every online member of the alliance's clans.
+func notifyAlliance(a *AllianceInfo, deps *Deps, fn func(m *world.PlayerInfo)) {
+	for _, id := range a.ClanIDs {
+		if id == 0 {
+			continue
+		}
+		c := deps.World.Clans.GetClan(id)
+		if c == nil {
+			continue
+		}
+		for charID := range c.Members {
+			if m := deps.World.GetByCharID(charID); m != nil {
+				fn(m)
+			}
+		}
+	}
+}
+
+func clanLeaderOK(p *world.PlayerInfo, deps *Deps) *world.ClanInfo {
+	if p.ClanID == 0 {
+		return nil
+	}
+	c := deps.World.Clans.GetClan(p.ClanID)
+	if c == nil || c.LeaderID != p.CharID {
+		return nil
+	}
+	return c
+}
+
+// saveAlliance persists (insert/update/delete) an alliance; a no-op without a database (tests).
+func saveAlliance(a *AllianceInfo, deps *Deps) {
+	if deps.ClanRepo == nil {
+		return
+	}
+	ctx := context.Background()
+	var err error
+	switch {
+	case a.ClanCount() < 2 && a.OrderID != 0:
+		err = deps.ClanRepo.DeleteAlliance(ctx, a.OrderID)
+	case a.OrderID == 0:
+		a.OrderID, err = deps.ClanRepo.InsertAlliance(ctx, a.ClanIDs)
+	default:
+		err = deps.ClanRepo.UpdateAlliance(ctx, a.OrderID, a.ClanIDs)
+	}
+	if err != nil && deps.Log != nil {
+		deps.Log.Warn("alliance save failed", zap.Error(err))
+	}
+}
