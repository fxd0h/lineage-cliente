+// HandleAllianceLeaveResponse handles the answer to the withdraw dialog (C_Attr 1210).
+func HandleAllianceLeaveResponse(sess *net.Session, player *world.PlayerInfo, accepted bool, deps *Deps) {
+	if !accepted || deps.Alliances == nil {
+		return
+	}
+	clan := clanLeaderOK(player, deps)
+	if clan == nil {
+		return
+	}
+	a := deps.Alliances.GetAllianceByClan(clan.ClanID)
+	if a == nil {
 		return
 	}
+	if deps.War != nil && deps.War.IsClanInWar(clan.ClanName) {
+		SendServerMessage(sess, 1203)
+		return
+	}
+	// Tell everybody (including the leaving clan) before the slot is cleared.
+	notifyAlliance(a, deps, func(m *world.PlayerInfo) {
+		for _, id := range a.ClanIDs {
+			if other := deps.World.Clans.GetClan(id); other != nil && id != clan.ClanID {
+				m.Session.Send(BuildWarPacket(7, clan.ClanName, other.ClanName)) // S_War 7: alliance broken
+			}
+		}
+		SendServerMessageArgs(m.Session, 1204, clan.ClanName)
+	})
+	var rest []int32
+	for _, id := range a.ClanIDs {
+		if id != 0 && id != clan.ClanID {
+			rest = append(rest, id)
+		}
+	}
+	a.ClanIDs = [4]int32{}
+	copy(a.ClanIDs[:], rest) // keeps order, so the next clan becomes the prince if the prince left
+	saveAlliance(a, deps)
+	if a.ClanCount() < 2 {
+		deps.Alliances.RemoveAlliance(a.OrderID)
+	}
+}
