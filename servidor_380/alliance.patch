+// LoadAlliances fills the manager from the database at startup.
+func (m *AllianceManager) LoadAlliances(rows []persist.AllianceRow) {
+	for _, r := range rows {
+		m.AddAlliance(&AllianceInfo{OrderID: r.OrderID, ClanIDs: r.ClanIDs})
+	}
+}
 
