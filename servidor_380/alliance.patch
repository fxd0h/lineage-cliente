+// HandleAllianceInviteResponse handles the answer to the invite dialog (C_Attr 223); `inviterID` is the lord.
+func HandleAllianceInviteResponse(sess *net.Session, player *world.PlayerInfo, inviterID int32, accepted bool, deps *Deps) {
+	inviter := deps.World.GetByCharID(inviterID)
+	if inviter == nil || deps.Alliances == nil {
+		return
+	}
+	if !accepted {
+		SendServerMessage(inviter.Session, 1198) // the other party refused the alliance
+		return
+	}
+	iclan, tclan := clanLeaderOK(inviter, deps), clanLeaderOK(player, deps)
+	if iclan == nil || tclan == nil || iclan.ClanID == tclan.ClanID ||
+		deps.Alliances.GetAllianceByClan(tclan.ClanID) != nil {
+		SendServerMessage(inviter.Session, 1201)
+		return
+	}
+	a := deps.Alliances.GetAllianceByClan(iclan.ClanID)
+	if a == nil {
+		a = &AllianceInfo{ClanIDs: [4]int32{iclan.ClanID, tclan.ClanID}}
+		deps.Alliances.AddAlliance(a) // order id 0 until saved
+	} else if a.alliancePrince() != iclan.ClanID || a.ClanCount() >= len(a.ClanIDs) {
+		SendServerMessage(inviter.Session, 1201)
+		return
+	} else {
+		for i, id := range a.ClanIDs {
+			if id == 0 {
+				a.ClanIDs[i] = tclan.ClanID
+				break
+			}
+		}
+	}
+	oldID := a.OrderID
+	saveAlliance(a, deps)
+	if oldID == 0 { // re-key the new alliance under its database order id
+		deps.Alliances.reindex(a)
+	}
+	notifyAlliance(a, deps, func(m *world.PlayerInfo) {
+		m.Session.Send(BuildWarPacket(6, iclan.ClanName, tclan.ClanName)) // S_War 6: X and Y formed an alliance
+		SendServerMessageArgs(m.Session, 1200, tclan.ClanName)            // Y clan joined the alliance
+	})
 }
 
