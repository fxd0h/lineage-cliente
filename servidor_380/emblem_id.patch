 // NewClanManager creates an empty ClanManager.
+// EmblemLookup returns the emblem ID of a clan (0 if none); set by NewClanManager.
+// Used by the char packs so clients can request the emblem (S_Emblem download).
+var EmblemLookup = func(clanID int32) int32 { return 0 }
+
 func NewClanManager() *ClanManager {
+	m := newClanManager()
+	EmblemLookup = func(clanID int32) int32 {
+		if c := m.GetClan(clanID); c != nil {
+			return c.EmblemID
+		}
+		return 0
+	}
+	return m
+}
