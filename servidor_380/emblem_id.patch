+
+// clanEmblemID returns the emblem ID of the player's clan (0 without clan or emblem).
+func clanEmblemID(p *world.PlayerInfo) int32 {
+	if p.ClanID == 0 {
+		return 0
+	}
+	return world.EmblemLookup(p.ClanID)
+}
