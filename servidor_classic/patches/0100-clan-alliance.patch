From dfe86efbbc92a1a639392cbbceb782470f68f558 Mon Sep 17 00:00:00 2001
From: local <l@l>
Date: Tue, 17 Nov 2026 06:18:30 -0300
Subject: [PATCH] Clan alliances for the s3ep1 client (C_Rank sub 2/3/4, C_Attr
 223, clan_alliance table)

---
 .../server/server/clientpackets/C_Attr.java   |   4 +
 .../server/server/clientpackets/C_Rank.java   |  17 +-
 src/l1j/server/server/model/L1Alliance.java   | 282 ++++++++++++++++++
 3 files changed, 302 insertions(+), 1 deletion(-)
 create mode 100644 src/l1j/server/server/model/L1Alliance.java

diff --git a/src/l1j/server/server/clientpackets/C_Attr.java b/src/l1j/server/server/clientpackets/C_Attr.java
index f1392e03..f15b151e 100644
--- a/src/l1j/server/server/clientpackets/C_Attr.java
+++ b/src/l1j/server/server/clientpackets/C_Attr.java
@@ -80,6 +80,10 @@ public class C_Attr extends ClientBasePacket {
 		L1PcInstance pc = client.getActiveChar();
 
 		switch (i) {
+		case 223: // alliance invitation from another lord
+			c = readC();
+			l1j.server.server.model.L1Alliance.inviteAnswer(pc, c == 1);
+			break;
 		case 97:
 			c = readC();
 			L1PcInstance joinPc = (L1PcInstance) L1World.getInstance()
diff --git a/src/l1j/server/server/clientpackets/C_Rank.java b/src/l1j/server/server/clientpackets/C_Rank.java
index 17658338..7d733154 100644
--- a/src/l1j/server/server/clientpackets/C_Rank.java
+++ b/src/l1j/server/server/clientpackets/C_Rank.java
@@ -23,6 +23,7 @@ import org.slf4j.Logger;
 import org.slf4j.LoggerFactory;
 
 import l1j.server.server.datatables.CharacterTable;
+import l1j.server.server.model.L1Alliance;
 import l1j.server.server.model.L1Clan;
 import l1j.server.server.model.L1Quest;
 import l1j.server.server.model.L1World;
@@ -41,7 +42,21 @@ public class C_Rank extends ClientBasePacket {
 	public C_Rank(byte abyte0[], Client client) throws Exception {
 		super(abyte0);
 		
-		readC(); //not currently used
+		int sub = readC();
+		if (sub >= 2 && sub <= 4) { // alliance: list / join (face to face) / leave, no more fields
+			L1PcInstance pc = client.getActiveChar();
+			if (pc == null) {
+				return;
+			}
+			if (sub == 2) {
+				L1Alliance.list(pc);
+			} else if (sub == 3) {
+				L1Alliance.invite(pc);
+			} else {
+				L1Alliance.leave(pc);
+			}
+			return;
+		}
 		int rank = readC();
 		String name = readS();
 
diff --git a/src/l1j/server/server/model/L1Alliance.java b/src/l1j/server/server/model/L1Alliance.java
new file mode 100644
index 00000000..f178f534
--- /dev/null
+++ b/src/l1j/server/server/model/L1Alliance.java
@@ -0,0 +1,282 @@
+package l1j.server.server.model;
+
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Statement;
+import java.util.ArrayList;
+import java.util.List;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import l1j.server.L1DatabaseFactory;
+import l1j.server.server.model.Instance.L1PcInstance;
+import l1j.server.server.serverpackets.S_ServerMessage;
+import l1j.server.server.serverpackets.S_SystemMessage;
+import l1j.server.server.serverpackets.S_War;
+import l1j.server.server.utils.FaceToFace;
+import l1j.server.server.utils.SQLUtil;
+
+/**
+ * Clan alliances of the s3ep1 client (packet C_Rank sub 2 = list, 3 = join, 4 = leave).
+ * Up to 4 clans per alliance; slot 0 is the clan that formed it (the only one that can invite).
+ * Persisted in clan_alliance (clan_id, alliance_id, slot), loaded lazily.
+ */
+public final class L1Alliance {
+	private static final Logger _log = LoggerFactory.getLogger(L1Alliance.class.getName());
+	public static final int MAX_CLANS = 4;
+	public static final int MIN_LORD_LEVEL = 25;
+	/** C_Attr yes/no id of the invitation ("Lord of %0 Blood Pledge wants to form an alliance"). */
+	public static final int INVITE_YN = 223;
+
+	private static final List<List<Integer>> _alliances = new ArrayList<List<Integer>>();
+	private static boolean _loaded = false;
+
+	private L1Alliance() {
+	}
+
+	private static synchronized void load() {
+		if (_loaded) {
+			return;
+		}
+		_loaded = true;
+		Connection con = null;
+		Statement st = null;
+		PreparedStatement pstm = null;
+		ResultSet rs = null;
+		try {
+			con = L1DatabaseFactory.getInstance().getConnection();
+			st = con.createStatement();
+			st.execute("CREATE TABLE IF NOT EXISTS clan_alliance (clan_id INT NOT NULL PRIMARY KEY,"
+					+ " alliance_id INT NOT NULL, slot INT NOT NULL)");
+			pstm = con.prepareStatement("SELECT clan_id, alliance_id FROM clan_alliance ORDER BY alliance_id, slot");
+			rs = pstm.executeQuery();
+			int last = -1;
+			List<Integer> cur = null;
+			while (rs.next()) {
+				if (rs.getInt(2) != last) {
+					last = rs.getInt(2);
+					cur = new ArrayList<Integer>();
+					_alliances.add(cur);
+				}
+				cur.add(rs.getInt(1));
+			}
+		} catch (SQLException e) {
+			_log.error(e.getLocalizedMessage(), e);
+		} finally {
+			SQLUtil.close(rs);
+			SQLUtil.close(pstm);
+			SQLUtil.close(st);
+			SQLUtil.close(con);
+		}
+	}
+
+	private static void save() {
+		Connection con = null;
+		Statement st = null;
+		PreparedStatement pstm = null;
+		try {
+			con = L1DatabaseFactory.getInstance().getConnection();
+			st = con.createStatement();
+			st.execute("DELETE FROM clan_alliance");
+			pstm = con.prepareStatement("INSERT INTO clan_alliance (clan_id, alliance_id, slot) VALUES (?,?,?)");
+			int id = 1;
+			for (List<Integer> a : _alliances) {
+				for (int i = 0; i < a.size(); i++) {
+					pstm.setInt(1, a.get(i));
+					pstm.setInt(2, id);
+					pstm.setInt(3, i);
+					pstm.execute();
+				}
+				id++;
+			}
+		} catch (SQLException e) {
+			_log.error(e.getLocalizedMessage(), e);
+		} finally {
+			SQLUtil.close(pstm);
+			SQLUtil.close(st);
+			SQLUtil.close(con);
+		}
+	}
+
+	private static List<Integer> find(int clanId) {
+		load();
+		for (List<Integer> a : _alliances) {
+			if (a.contains(clanId)) {
+				return a;
+			}
+		}
+		return null;
+	}
+
+	/** Ids of the clans allied with clanId, including itself (empty when none). */
+	public static synchronized List<Integer> clansOf(int clanId) {
+		List<Integer> a = find(clanId);
+		return a == null ? new ArrayList<Integer>() : new ArrayList<Integer>(a);
+	}
+
+	private static boolean inWar(L1Clan clan) {
+		for (L1War war : L1World.getInstance().getWarList()) {
+			if (war.CheckClanInWar(clan.getClanName())) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	private static L1Clan lordClan(L1PcInstance pc) {
+		L1Clan clan = L1World.getInstance().getClan(pc.getClanname());
+		if (clan == null || !pc.isCrown() || pc.getId() != clan.getLeaderId()) {
+			pc.sendPackets(new S_ServerMessage(518)); // only a lord of a pledge
+			return null;
+		}
+		return clan;
+	}
+
+	private static void tell(List<Integer> clanIds, java.util.function.Consumer<L1PcInstance> fn) {
+		for (int id : clanIds) {
+			for (L1Clan c : L1World.getInstance().getAllClans()) {
+				if (c.getClanId() == id) {
+					for (L1PcInstance m : c.getOnlineClanMember()) {
+						fn.accept(m);
+					}
+				}
+			}
+		}
+	}
+
+	private static L1Clan byId(int id) {
+		for (L1Clan c : L1World.getInstance().getAllClans()) {
+			if (c.getClanId() == id) {
+				return c;
+			}
+		}
+		return null;
+	}
+
+	/** C_Rank sub 3: the lord faces another lord and asks him to ally. */
+	public static synchronized void invite(L1PcInstance pc) {
+		L1Clan clan = lordClan(pc);
+		if (clan == null) {
+			return;
+		}
+		if (pc.getLevel() < MIN_LORD_LEVEL) {
+			pc.sendPackets(new S_ServerMessage(1206));
+			return;
+		}
+		L1PcInstance target = FaceToFace.faceToFace(pc); // sends 93 / 91 itself
+		if (target == null) {
+			return;
+		}
+		L1Clan tclan = L1World.getInstance().getClan(target.getClanname());
+		if (tclan == null || !target.isCrown() || target.getId() != tclan.getLeaderId()
+				|| target.getLevel() < MIN_LORD_LEVEL || tclan.getClanId() == clan.getClanId()) {
+			pc.sendPackets(new S_ServerMessage(1199));
+			return;
+		}
+		if (inWar(clan) || inWar(tclan)) {
+			pc.sendPackets(new S_ServerMessage(1234));
+			return;
+		}
+		List<Integer> mine = find(clan.getClanId());
+		if (mine != null && (mine.get(0) != clan.getClanId() || mine.size() >= MAX_CLANS)) {
+			pc.sendPackets(new S_ServerMessage(1201));
+			return;
+		}
+		if (find(tclan.getClanId()) != null) {
+			pc.sendPackets(new S_ServerMessage(1202));
+			return;
+		}
+		target.setTempID(pc.getId());
+		target.sendPackets(new l1j.server.server.serverpackets.S_Message_YN(INVITE_YN, clan.getClanName()));
+	}
+
+	/** C_Attr 223: the invited lord answers. */
+	public static synchronized void inviteAnswer(L1PcInstance target, boolean yes) {
+		L1PcInstance pc = (L1PcInstance) L1World.getInstance().findObject(target.getTempID());
+		target.setTempID(0);
+		if (pc == null) {
+			return;
+		}
+		if (!yes) {
+			pc.sendPackets(new S_ServerMessage(1198));
+			return;
+		}
+		L1Clan clan = L1World.getInstance().getClan(pc.getClanname());
+		L1Clan tclan = L1World.getInstance().getClan(target.getClanname());
+		if (clan == null || tclan == null || find(tclan.getClanId()) != null) {
+			pc.sendPackets(new S_ServerMessage(1201));
+			return;
+		}
+		List<Integer> a = find(clan.getClanId());
+		if (a == null) {
+			a = new ArrayList<Integer>();
+			a.add(clan.getClanId());
+			_alliances.add(a);
+		} else if (a.get(0) != clan.getClanId() || a.size() >= MAX_CLANS) {
+			pc.sendPackets(new S_ServerMessage(1201));
+			return;
+		}
+		a.add(tclan.getClanId());
+		save();
+		final String n1 = clan.getClanName();
+		final String n2 = tclan.getClanName();
+		tell(a, m -> {
+			m.sendPackets(new S_War(6, n1, n2));
+			m.sendPackets(new S_ServerMessage(1200, n2));
+		});
+	}
+
+	/** C_Rank sub 4: the lord withdraws his clan (the client already asked for confirmation). */
+	public static synchronized void leave(L1PcInstance pc) {
+		L1Clan clan = lordClan(pc);
+		if (clan == null) {
+			return;
+		}
+		List<Integer> a = find(clan.getClanId());
+		if (a == null) {
+			pc.sendPackets(new S_ServerMessage(1233));
+			return;
+		}
+		if (inWar(clan)) {
+			pc.sendPackets(new S_ServerMessage(1203));
+			return;
+		}
+		final String n = clan.getClanName();
+		List<Integer> all = new ArrayList<Integer>(a);
+		tell(all, m -> {
+			for (int id : all) {
+				L1Clan o = byId(id);
+				if (o != null && id != clan.getClanId()) {
+					m.sendPackets(new S_War(7, n, o.getClanName()));
+				}
+			}
+			m.sendPackets(new S_ServerMessage(1204, n));
+		});
+		a.remove(Integer.valueOf(clan.getClanId()));
+		if (a.size() < 2) {
+			_alliances.remove(a);
+		}
+		save();
+	}
+
+	/** C_Rank sub 2: lists the allied clans (the 2009 client has no known list packet, so a system message). */
+	public static synchronized void list(L1PcInstance pc) {
+		L1Clan clan = L1World.getInstance().getClan(pc.getClanname());
+		List<Integer> a = clan == null ? null : find(clan.getClanId());
+		if (a == null) {
+			pc.sendPackets(new S_ServerMessage(1233));
+			return;
+		}
+		StringBuilder sb = new StringBuilder("Alliance:");
+		for (int id : a) {
+			L1Clan o = byId(id);
+			if (o != null) {
+				sb.append(' ').append(o.getClanName()).append(id == a.get(0) ? "*" : "");
+			}
+		}
+		pc.sendPackets(new S_SystemMessage(sb.toString()));
+	}
+}
