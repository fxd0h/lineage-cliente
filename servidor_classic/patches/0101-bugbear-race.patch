diff --git a/src/l1j/server/server/model/L1BugBearRace.java b/src/l1j/server/server/model/L1BugBearRace.java
new file mode 100644
index 00000000..47faf54c
--- /dev/null
+++ b/src/l1j/server/server/model/L1BugBearRace.java
@@ -0,0 +1,495 @@
+package l1j.server.server.model;
+
+import java.util.concurrent.ThreadLocalRandom;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import l1j.server.server.GeneralThreadPool;
+import l1j.server.server.datatables.DoorTable;
+import l1j.server.server.datatables.NpcTable;
+import l1j.server.server.datatables.RaceTicketTable;
+import l1j.server.server.datatables.ShopTable;
+import l1j.server.server.encryptions.IdFactory;
+import l1j.server.server.model.Instance.L1DoorInstance;
+import l1j.server.server.model.Instance.L1MerchantInstance;
+import l1j.server.server.model.Instance.L1NpcInstance;
+import l1j.server.server.model.Instance.L1PcInstance;
+import l1j.server.server.model.map.L1Map;
+import l1j.server.server.model.shop.L1Shop;
+import l1j.server.server.serverpackets.S_NPCPack;
+import l1j.server.server.serverpackets.S_NpcChatPacket;
+import l1j.server.server.templates.L1Npc;
+import l1j.server.server.templates.L1RaceTicket;
+import l1j.server.server.templates.L1ShopItem;
+
+/**
+ * Giran Bugbear Race, ported from L1J-JP. One race every ~11 minutes: the
+ * ticket sellers (Maeno 70041, Polly 70035, Secil 70042) sell one ticket per
+ * runner while the round is open, then five of the twenty runners (npc 91350+)
+ * race around the track; tickets of the winner are bought back by the sellers
+ * for price * allotment.
+ */
+public class L1BugBearRace {
+	private static final Logger _log = LoggerFactory.getLogger(L1BugBearRace.class.getName());
+
+	public static final int STATUS_NONE = 0;
+	public static final int STATUS_READY = 1;
+	public static final int STATUS_PLAYING = 2;
+	public static final int STATUS_END = 3;
+
+	public static final int TICKET_ITEM_ID = 40309;
+	public static final int TICKET_PRICE = 500;
+	public static final int FIRST_NPCID = 91350; // 20 runners
+	private static final int RUNNERS = 5;
+	private static final int[] SELLER_NPCIDS = { 70035, 70041, 70042 };
+	private static final int WAIT_TIME = 60; // seconds between races
+	private static final int READY_TIME = Integer.getInteger("l1j.race.ready", 9 * 60 - 10); // betting seconds
+	private static final int END_WAIT = 30;
+	private static final int MAX_RACE_SECONDS = 5 * 60;
+	private static final int MAP_ID = 4;
+
+	private final L1NpcInstance[] _runner = new L1NpcInstance[RUNNERS];
+	private final int[] _runnerStatus = new int[RUNNERS];
+	private final double[] _winningAverage = new double[RUNNERS];
+	private final double[] _allotmentPercentage = new double[RUNNERS];
+	private final int[] _condition = new int[RUNNERS];
+	private final int[] _betCount = new int[RUNNERS];
+	private volatile int _allBet;
+	private volatile int _round;
+	private volatile int _status = STATUS_NONE;
+
+	private L1MerchantInstance _maeno;
+	private L1MerchantInstance _polly;
+	private L1MerchantInstance _secil;
+
+	private static L1BugBearRace _instance;
+
+	public static synchronized L1BugBearRace getInstance() {
+		if (_instance == null) {
+			_instance = new L1BugBearRace();
+		}
+		return _instance;
+	}
+
+	private L1BugBearRace() {
+		_round = RaceTicketTable.getInstance().getRoundNumOfMax();
+	}
+
+	/** Starts the race cycle; call once the world (NPC spawns, doors, shops) is loaded. */
+	public void start() {
+		Thread t = new Thread(new Runnable() {
+			@Override
+			public void run() {
+				cycle();
+			}
+		}, "BugBearRace");
+		t.setDaemon(true);
+		t.start();
+	}
+
+	public int getRound() {
+		return _round;
+	}
+
+	public int getGameStatus() {
+		return _status;
+	}
+
+	public int getAllBet() {
+		return _allBet;
+	}
+
+	/** Adds a bet; 10 percent of the stake is kept by the house. */
+	public synchronized void addBet(int runnerIndex, int stake, int count) {
+		_allBet += (int) (stake * 0.9);
+		_betCount[runnerIndex] += count;
+	}
+
+	public L1NpcInstance getRunner(int num) {
+		return _runner[num];
+	}
+
+	/** Index (0..4) of the runner with the given 1-based runner number, or -1. */
+	public int indexOfRunnerNumber(int runnerNum) {
+		for (int i = 0; i < RUNNERS; i++) {
+			if (_runner[i] != null && _runner[i].getNpcId() - FIRST_NPCID + 1 == runnerNum) {
+				return i;
+			}
+		}
+		return -1;
+	}
+
+	public int getCondition(int num) {
+		return _condition[num];
+	}
+
+	public double getWinningAverage(int num) {
+		return _winningAverage[num];
+	}
+
+	private void findSellers() {
+		for (L1Object obj : L1World.getInstance().getObject()) {
+			if (obj instanceof L1MerchantInstance) {
+				L1MerchantInstance m = (L1MerchantInstance) obj;
+				switch (m.getNpcId()) {
+				case 70041:
+					_maeno = m;
+					break;
+				case 70035:
+					_polly = m;
+					break;
+				case 70042:
+					_secil = m;
+					break;
+				default:
+					break;
+				}
+			}
+		}
+	}
+
+	private void announce(String text) {
+		for (L1MerchantInstance m : new L1MerchantInstance[] { _maeno, _secil }) {
+			if (m != null) {
+				m.wideBroadcastPacket(new S_NpcChatPacket(m, text, 2));
+			}
+		}
+	}
+
+	private void cycle() {
+		try {
+			Thread.sleep(10 * 1000); // let the server finish starting
+			findSellers();
+			if (_maeno == null) {
+				_log.warn("Bugbear race: Maeno (70041) is not spawned, race disabled");
+				return;
+			}
+			while (true) {
+				runOneRace();
+				Thread.sleep(END_WAIT * 1000);
+			}
+		} catch (InterruptedException e) {
+			Thread.currentThread().interrupt();
+		} catch (Throwable e) {
+			_log.error("Bugbear race stopped: " + e.getLocalizedMessage(), e);
+		}
+	}
+
+	private void runOneRace() throws InterruptedException {
+		_status = STATUS_NONE;
+		announce("$376 10 $377");
+		Thread.sleep(WAIT_TIME * 1000L);
+
+		clearRunner();
+		_round++;
+		L1RaceTicket marker = new L1RaceTicket();
+		marker.setItemObjId(0);
+		marker.setRound(_round);
+		RaceTicketTable.getInstance().storeNewTicket(marker);
+		RaceTicketTable.getInstance().deleteOldRoundMarkers(_round);
+		setRandomRunner();
+		setRandomCondition();
+		setWinningAverage();
+		openShops();
+		_status = STATUS_READY;
+		_log.info("Bugbear race round " + _round + ": betting open");
+
+		for (int loop = 0; loop < READY_TIME - 1; loop++) {
+			if (loop % 60 == 0) {
+				announce("$376 " + (1 + (READY_TIME - loop) / 60) + " $377");
+			}
+			Thread.sleep(1000);
+		}
+		announce("$363"); // Ready!
+		Thread.sleep(1000);
+		for (int i = 10; i > 0; i--) {
+			announce(String.valueOf(i));
+			Thread.sleep(1000);
+		}
+		announce("$364"); // Go!
+		_status = STATUS_PLAYING;
+		closeShops();
+		for (L1DoorInstance door : DoorTable.getInstance().getDoorList()) {
+			if (isRaceDoor(door)) {
+				door.open();
+			}
+		}
+		for (int i = 0; i < RUNNERS; i++) {
+			new BugBearRunning(i).begin();
+		}
+		GeneralThreadPool.getInstance().scheduleAtFixedRate(new SpeedBuff(), 1000, 1000);
+		_log.info("Bugbear race round " + _round + ": started");
+		synchronized (this) {
+			for (int i = 0; i < RUNNERS; i++) {
+				if (_betCount[i] > 0) {
+					// +0.2 so that a lone bettor still profits
+					double p = (double) _allBet / _betCount[i] / TICKET_PRICE + 0.2;
+					_allotmentPercentage[i] = Math.floor(p * 100) / 100;
+				} else {
+					_allotmentPercentage[i] = 0.0;
+				}
+			}
+		}
+		for (int i = 0; i < RUNNERS; i++) {
+			Thread.sleep(1000);
+			announce(NpcTable.getInstance().getTemplate(_runner[i].getNpcId()).get_nameid()
+					+ " $402 " + _allotmentPercentage[i]);
+		}
+		for (int s = 0; s < MAX_RACE_SECONDS && _status == STATUS_PLAYING; s++) {
+			Thread.sleep(1000);
+		}
+		_status = STATUS_END;
+		_log.info("Bugbear race round " + _round + ": finished");
+	}
+
+	private static boolean isRaceDoor(L1DoorInstance door) {
+		return door.getDoorId() >= 808 && door.getDoorId() <= 812;
+	}
+
+	private void openShops() {
+		for (int npcId : SELLER_NPCIDS) {
+			L1Shop shop = ShopTable.getInstance().get(npcId);
+			if (shop == null) {
+				continue;
+			}
+			synchronized (shop.getSellingItems()) {
+				shop.getSellingItems().clear();
+				for (int i = 0; i < RUNNERS; i++) {
+					L1ShopItem item = new L1ShopItem(TICKET_ITEM_ID, TICKET_PRICE, 1);
+					item.setTicketName(_round, _runner[i].getNpcId() - FIRST_NPCID + 1);
+					shop.getSellingItems().add(item);
+				}
+			}
+		}
+	}
+
+	private void closeShops() {
+		for (int npcId : SELLER_NPCIDS) {
+			L1Shop shop = ShopTable.getInstance().get(npcId);
+			if (shop != null) {
+				shop.getSellingItems().clear();
+			}
+		}
+	}
+
+	private void setRandomRunner() {
+		ThreadLocalRandom rnd = ThreadLocalRandom.current();
+		for (int i = 0; i < RUNNERS; i++) {
+			int npcid = FIRST_NPCID + rnd.nextInt(20);
+			while (isDuplicate(npcid, i)) {
+				npcid = FIRST_NPCID + rnd.nextInt(20);
+			}
+			_runner[i] = spawnRunner(33522 - (i * 2), 32861 + (i * 2), npcid);
+		}
+	}
+
+	private boolean isDuplicate(int npcid, int n) {
+		for (int i = 0; i < n; i++) {
+			if (_runner[i] != null && _runner[i].getNpcId() == npcid) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	private void clearRunner() {
+		for (int i = 0; i < RUNNERS; i++) {
+			L1NpcInstance r = _runner[i];
+			if (r != null) {
+				L1Map map = r.getMap();
+				r.deleteMe();
+				if (map.isInMap(r.getX(), r.getY())) {
+					map.setPassable(r.getX(), r.getY(), true);
+				}
+			}
+			_runner[i] = null;
+			_runnerStatus[i] = 0;
+			_condition[i] = 0;
+			_winningAverage[i] = 0;
+			_allotmentPercentage[i] = 0.0;
+			_betCount[i] = 0;
+		}
+		_allBet = 0;
+		for (L1DoorInstance door : DoorTable.getInstance().getDoorList()) {
+			if (isRaceDoor(door)) {
+				door.close();
+			}
+		}
+	}
+
+	private L1NpcInstance spawnRunner(int x, int y, int npcid) {
+		L1Npc template = NpcTable.getInstance().getTemplate(npcid);
+		L1NpcInstance mob = new L1NpcInstance(template);
+		mob.setNameId("#" + (npcid - FIRST_NPCID + 1) + " " + mob.getNameId());
+		mob.setId(IdFactory.getInstance().nextId());
+		mob.setHeading(6);
+		mob.setX(x);
+		mob.setHomeX(x);
+		mob.setY(y);
+		mob.setHomeY(y);
+		mob.setMap((short) MAP_ID);
+		L1World.getInstance().storeObject(mob);
+		L1World.getInstance().addVisibleObject(mob);
+		S_NPCPack pack = new S_NPCPack(mob);
+		for (L1PcInstance pc : L1World.getInstance().getRecognizePlayer(mob)) {
+			pc.addKnownObject(mob);
+			mob.addKnownObject(pc);
+			pc.sendPackets(pack);
+		}
+		return mob;
+	}
+
+	/**
+	 * Checks the runner against the track legs and turns it at the corners;
+	 * returns true once it has crossed the finish line.
+	 */
+	private boolean checkPosition(int n) {
+		final int[] heading = { 6, 7, 0, 1, 2, 2 };
+		if (_status != STATUS_PLAYING) {
+			return false;
+		}
+		L1NpcInstance npc = _runner[n];
+		int x = npc.getX();
+		int y = npc.getY();
+		boolean next = false;
+		switch (_runnerStatus[n]) {
+		case 0:
+			next = x >= 33476 && x <= 33476 + 8 && y >= 32861 && y <= 32861 + 8;
+			break;
+		case 1:
+			next = x <= 33473 && x >= 33473 - 9 && y == 32858;
+			break;
+		case 2:
+			next = x <= 33473 && x >= 33473 - 9 && y == 32852;
+			break;
+		case 3:
+			next = x == 33478 && y <= 32847 && y >= 32847 - 9;
+			break;
+		case 4:
+			next = x == 33523 && y >= 32847 - 9 && y <= 32847;
+			break;
+		case 5:
+			if (x == 33527 && y >= 32847 - 8 && y <= 32847) {
+				npc.setHeading(heading[5]);
+				finish();
+				return true;
+			}
+			break;
+		default:
+			break;
+		}
+		if (next) {
+			_runnerStatus[n]++;
+			if (_runnerStatus[n] == 5) {
+				goal(n);
+			}
+		}
+		npc.setHeading(heading[_runnerStatus[n]]);
+		return false;
+	}
+
+	private synchronized void finish() {
+		int cnt = 0;
+		for (int s : _runnerStatus) {
+			if (s == 5) {
+				cnt++;
+			}
+		}
+		if (cnt == RUNNERS) {
+			_status = STATUS_END;
+		}
+	}
+
+	private synchronized void goal(int n) {
+		int cnt = 0;
+		for (int s : _runnerStatus) {
+			if (s == 5) {
+				cnt++;
+			}
+		}
+		if (cnt == 1) { // first across the line
+			String name = NpcTable.getInstance().getTemplate(_runner[n].getNpcId()).get_nameid();
+			announce("Round " + _round + " $366 " + name + " $367");
+			RaceTicketTable.getInstance().updateTicket(_round, _runner[n].getNpcId() - FIRST_NPCID + 1,
+					_allotmentPercentage[n]);
+		}
+	}
+
+	private class BugBearRunning implements Runnable {
+		private final int _n;
+		private final L1NpcInstance _bug;
+
+		BugBearRunning(int n) {
+			_n = n;
+			_bug = _runner[n];
+		}
+
+		void begin() {
+			GeneralThreadPool.getInstance().schedule(this, 0);
+		}
+
+		@Override
+		public void run() {
+			try {
+				if (_status != STATUS_PLAYING) {
+					return;
+				}
+				_bug.setDirectionMove(newHeading());
+				if (checkPosition(_n)) {
+					return;
+				}
+				int sleep = _bug.getPassispeed();
+				if (_bug.getBraveSpeed() == 1) {
+					sleep -= sleep * 0.25;
+				}
+				GeneralThreadPool.getInstance().schedule(this, Math.max(sleep, 50));
+			} catch (Throwable e) {
+				_log.error("Bugbear runner failed: " + e.getLocalizedMessage(), e);
+			}
+		}
+
+		private int newHeading() {
+			int x = _bug.getX();
+			int y = _bug.getY();
+			int heading = _bug.getHeading();
+			L1Map map = _bug.getMap();
+			for (int tries = 0; tries < 8 && !map.isPassable(x, y, heading); tries++) {
+				int right = (heading + 1) & 7;
+				if (map.isPassable(x, y, right)) {
+					return right;
+				}
+				heading = (heading + 7) & 7;
+			}
+			return heading;
+		}
+	}
+
+	/** Once a second each runner gets a burst of speed with a chance tied to its form. */
+	private class SpeedBuff implements Runnable {
+		@Override
+		public void run() {
+			if (_status != STATUS_PLAYING) {
+				throw new RuntimeException("race over"); // cancels the periodic task
+			}
+			ThreadLocalRandom rnd = ThreadLocalRandom.current();
+			for (int i = 0; i < RUNNERS; i++) {
+				double roll = (rnd.nextInt(10000) + 1) / 100D;
+				_runner[i].setBraveSpeed(roll <= _winningAverage[i] * (1 + 0.2 * _condition[i]) ? 1 : 0);
+			}
+		}
+	}
+
+	private void setRandomCondition() {
+		for (int i = 0; i < RUNNERS; i++) {
+			_condition[i] = -1 + ThreadLocalRandom.current().nextInt(3);
+		}
+	}
+
+	private void setWinningAverage() {
+		ThreadLocalRandom rnd = ThreadLocalRandom.current();
+		for (int i = 0; i < RUNNERS; i++) {
+			_winningAverage[i] = (rnd.nextInt(10000) + 1) / 100D;
+		}
+	}
+}
