From b3aa3b50c1ab05451ecbfae45ad4b0c635f58df6 Mon Sep 17 00:00:00 2001
From: local <l@l>
Date: Tue, 17 Nov 2026 05:56:03 -0300
Subject: [PATCH] Firewall cast from a safety zone cannot leave it (#39)

---
 src/l1j/server/server/model/L1EffectSpawn.java | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/l1j/server/server/model/L1EffectSpawn.java b/src/l1j/server/server/model/L1EffectSpawn.java
index d6a50d88..c613bbd0 100644
--- a/src/l1j/server/server/model/L1EffectSpawn.java
+++ b/src/l1j/server/server/model/L1EffectSpawn.java
@@ -159,6 +159,11 @@ public class L1EffectSpawn {
 				break;
 			}
 
+			// A caster inside a safety zone cannot burn tiles outside it (issue #39).
+			if (map.isSafetyZone(cha.getX(), cha.getY()) && !map.isSafetyZone(x, y)) {
+				break;
+			}
+
 			L1EffectInstance effect = spawnEffect(81157, duration * 1000, x, y,
 					cha.getMapId());
 			if (effect == null) {
-- 
